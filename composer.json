{
    "name": "portabilis/i-educar",
    "description": "Software livre de gestão escolar",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "version": "2.12.0",
    "keywords": [
        "Portabilis",
        "i-Educar"
    ],
    "authors": [
        {
            "name": "Portábilis",
            "email": "contato@portabilis.com.br",
            "homepage": "https://portabilis.com.br"
        }
    ],
    "homepage": "https://github.com/portabilis/i-educar",
    "require": {
        "php": "^8.5",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pgsql": "*",
        "ext-zip": "*",
        "aws/aws-sdk-php-laravel": "^3.11",
        "composer/semver": "^3.2",
        "dex/composer-plug-and-play": "^0.26",
        "dex/frontier": "^0.19.0",
        "google/recaptcha": "^1.2",
        "guzzlehttp/guzzle": "^7.15.2",
        "honeybadger-io/honeybadger-laravel": "^5.0",
        "intervention/image": "^2.6",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.15",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.26",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.2",
        "league/csv": "^9.7",
        "league/flysystem-aws-s3-v3": "^3.0",
        "league/flysystem-ftp": "^3.0",
        "league/flysystem-sftp-v3": "^3.0",
        "maatwebsite/excel": "^4.0",
        "predis/predis": "^2.3",
        "psr/simple-cache": "^3.0",
        "socialiteproviders/laravelpassport": "^4.3",
        "staudenmeir/laravel-adjacency-list": "^1.0",
        "symfony/http-client": "^6.0",
        "symfony/mailgun-mailer": "^6.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "laravel/telescope": "^5.18",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-browser": "^5.0",
        "phpunit/phpcov": "^13.1"
    },
    "autoload": {
        "classmap": [
            "ieducar/intranet/include",
            "ieducar/lib",
            "ieducar/modules/*/Model",
            "ieducar/modules/Avaliacao/Service",
            "ieducar/modules/Avaliacao/Views",
            "ieducar/modules/FormulaMedia/Validate",
            "ieducar/modules/RegraAvaliacao/Validators"
        ],
        "files": [
            "ieducar/intranet/include/funcoes.inc.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Custom\\": "database/custom/",
            "Database\\Seeders\\": "database/seeders/",
            "iEducar\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "classmap": [
            "tests/Unit"
        ]
    },
    "include-path": [
        "ieducar",
        "ieducar/intranet",
        "ieducar/lib",
        "ieducar/modules"
    ],
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "test:browser": "ASSETS_SECURE=false vendor/bin/pest tests/Browser",
        "test:browser:parallel": "ASSETS_SECURE=false LARAVEL_PARALLEL_TESTING_WITHOUT_DATABASES=1 vendor/bin/pest --parallel --processes=4 tests/Browser",
        "test:browser:coverage": "ASSETS_SECURE=false XDEBUG_MODE=coverage vendor/bin/pest tests/Browser --coverage-html coverage",
        "test:request": "vendor/bin/pest --testsuite=Request",
        "test:request:coverage": "XDEBUG_MODE=coverage vendor/bin/pest --testsuite=Request --coverage-html coverage",
        "coverage": [
            "Composer\\Config::disableProcessTimeout",
            "rm -rf coverage",
            "for suite in Diario Feature Pages Request Educacenso Unit; do XDEBUG_MODE=off php -d extension=pcov -d pcov.enabled=1 -d pcov.directory=$PWD vendor/bin/pest --compact --testsuite=$suite --coverage-php=coverage/cov/$suite.cov || exit 1; done",
            "php -d memory_limit=-1 vendor/bin/phpcov merge coverage/cov --html coverage/html --text coverage/coverage.txt",
            "sed -n '/Summary:/,/Lines:/p' coverage/coverage.txt"
        ],
        "openapi": "vendor/uderline/openapi-php-attributes/opag tests public/openapi.json",
        "set-permissions": "find bootstrap/cache -type d -exec chmod 777 {} + && find storage -type d -exec chmod 777 {} +",
        "new-install": [
            "@composer install",
            "@composer plug-and-play",
            "@set-permissions",
            "@php artisan key:generate --ansi",
            "@php artisan storage:link --ansi",
            "@php artisan migrate --force --ansi"
        ],
        "update-install": [
            "@composer update",
            "@composer plug-and-play",
            "@set-permissions",
            "@php artisan storage:link --ansi",
            "@php artisan migrate --force --ansi"
        ],
        "testing-install": [
            "@putenv DB_DATABASE=testing",
            "@putenv LEGACY_SEED_DATA=false",
            "@composer install",
            "@php artisan migrate --force --ansi"
        ],
        "post-install-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "dex/composer-plug-and-play": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
